<idea-plugin>
    <id>dev.gtnh.development</id>

    <name>GTNH Development</name>

    <vendor>GTNH Development Contributors</vendor>

    <description><![CDATA[
        IntelliJ IDEA tooling for GregTech: New Horizons development.

        Extends Minecraft Development with GTNH-specific project detection,
        Gradle integration, bidirectional Config/Mixin navigation, patch impact
        analysis, environment diagnostics, ecosystem discovery, contribution
        workflows, and previewed code generation.
    ]]></description>

    <!-- IntelliJ Platform -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Java support -->
    <depends>com.intellij.modules.java</depends>

    <!-- Gradle support -->
    <depends>com.intellij.gradle</depends>
    <depends>Git4Idea</depends>

    <!-- Minecraft Development: REQUIRED -->
    <depends>com.demonwav.minecraft-dev</depends>

    <extensions defaultExtensionNs="com.intellij">

        <applicationConfigurable
                parentId="tools"
                instance="dev.gtnh.intellij.settings.GtnhSettingsConfigurable"
                id="dev.gtnh.intellij.settings"
                displayName="GTNH Development"/>

        <postStartupActivity implementation="dev.gtnh.intellij.project.GtnhFirstRunActivity"/>

        <notificationGroup id="GTNH Development" displayType="BALLOON"/>

        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="dev.gtnh.intellij.mixin.GtnhMixinConfigLineMarkerProvider"/>

        <toolWindow
                id="GTNH"
                anchor="right"
                factoryClass="dev.gtnh.intellij.ui.GtnhToolWindowFactory"/>

    </extensions>

    <actions>
        <action id="dev.gtnh.intellij.FindGtnhMixinsForConfig"
                class="dev.gtnh.intellij.action.FindGtnhMixinsForConfigAction"
                text="Find GTNH Mixins Using This Config"
                description="Find Mixin registrations controlled by the selected configuration field">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
        </action>
        <action id="dev.gtnh.intellij.FindGtnhConfigForMixin"
                class="dev.gtnh.intellij.action.FindGtnhConfigForMixinAction"
                text="Find GTNH Config Controlling This Mixin"
                description="Find configuration fields controlling registration of selected Mixin class">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="dev.gtnh.intellij.ShowGtnhPatchImpact"
                class="dev.gtnh.intellij.action.ShowGtnhPatchImpactAction"
                text="Show GTNH Patch Impact"
                description="Find Mixins, ASM transformers, and access transformers affecting the selected target">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="dev.gtnh.intellij.NewGtnhMixin"
                class="dev.gtnh.intellij.action.NewGtnhMixinAction"
                text="New GTNH Mixin"
                description="Preview and create a standalone GTNH Mixin class">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="dev.gtnh.intellij.NewGtnhConfigEntry"
                class="dev.gtnh.intellij.action.NewGtnhConfigEntryAction"
                text="New GTNH Config Entry"
                description="Preview and create a safe standalone configuration entry">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
